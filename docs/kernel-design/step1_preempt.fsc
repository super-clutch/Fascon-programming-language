// Fascon 1.0 カーネル拡張 Step 1: プリエンプティブ切り替え（構文イメージ）
// 実装済み: 1.0 のコンパイラで通ります（fascon check）。動く例は examples/kernel_preempt.fsc。仕様: docs/SPEC-1.0-KERNEL.ja.md 4.1 節
// Implemented: accepted by the 1.0 compiler (fascon check); a runnable example is examples/kernel_preempt.fsc.

const READY: u8 = 1;
const BLOCKED: u8 = 2;
const TICK: u64 = 625000;                     // 62.5 MHz のカウンタで 10 ms / 10 ms at 62.5 MHz

struct Task { pid: u32, state: u8, vruntime: u64, wake_at: u64 }
struct Msg { from: u32, body: u64 }

// スロットごとに 16 KiB のカーネルスタックと保存文脈（隠れた列）を持つアリーナ
// an arena whose slots also carry a 16 KiB kernel stack and a saved context (hidden columns)
task_arena @task: Task[64] stack 16384;
arena @inbox: Msg[128];

// 仮想タイマー（CNTV, INTID 27）。GIC の許可・ACK・EOI は BSP が行う
// the virtual timer; the BSP enables, acknowledges and ends the interrupt
irq tick at 27 {
    timer_arm(TICK);
    let cur = @task.current();                // 割り込まれたタスク（生存は証明済み） / the interrupted task
    @task[cur].vruntime += 1;                 // irq の本体は閉じた区間: critical は要らない
    wake_sleepers(timer_now());
    if let Some(next) = pick_next() {
        @task.resume(next);                   // この割り込みの出口で next へ（予約するだけ） / switch on IRQ exit
    }
}

fn wake_sleepers(now: u64) {
    for id in @task {
        if @task[id].state == BLOCKED {
            if @task[id].wake_at <= now { @task[id].state = READY; }
        }
    }
}

// 方針は Fascon で書く。1.0 の列の走査（最小値の選択）がそのまま効く
// the policy is plain Fascon; the 1.0 column scan (min selection) applies as is
fn pick_next() -> Option<Id<@task>> {
    let mut best: u64 = 0xffff_ffff_ffff_ffff;
    let mut pick = None;
    for id in @task {
        if @task[id].state == READY {
            if @task[id].vruntime < best { best = @task[id].vruntime; pick = Some(id); }
        }
    }
    pick
}

// 関数まるごとが閉じた区間。@inbox は 2 つのタスクが触るので、無ければ F2601
// the whole function is a closed section; without it, F2601 (two tasks touch @inbox)
critical fn post(from: u32, body: u64) -> bool {
    match @inbox.alloc(Msg { from: from, body: body }) {
        Some(m) => true,
        None => false,
    }
}

critical fn sleep_until(t: u64) {
    let me = @task.current();
    @task[me].state = BLOCKED;
    @task[me].wake_at = t;
    if let Some(next) = pick_next() {
        @task.yield_to(next);                 // 閉じた区間の中から切り替えてよい（待ちに入る直前の起床を取りこぼさない）
    }
}

fn producer(arg: u64) {
    let mut n: u64 = 0;
    loop {
        if post(arg as u32, n) { n += 1; }
        sleep_until(timer_now() + 10 * TICK);
    }
}

fn spinner(arg: u64) {
    loop {
        cpu_relax();                          // 譲らないタスク: タイマーで切り替わる / never yields: preempted by the timer
    }
}

fn idle(arg: u64) {
    loop { wait_irq(); }
}

fn main() {
    // irq_open / enter より前は boot 文脈（割り込み禁止）: critical は要らない
    let a = @task.start(Task { pid: 1, state: READY, vruntime: 0, wake_at: 0 }, producer, 1).unwrap();
    let b = @task.start(Task { pid: 2, state: READY, vruntime: 0, wake_at: 0 }, spinner, 2).unwrap();
    let z = @task.start(Task { pid: 0, state: READY, vruntime: 0xffff_ffff, wake_at: 0 }, idle, 0).unwrap();
    timer_arm(TICK);
    @task.enter(a);                           // 割り込みを許可して a へ。戻らない / never returns
}
