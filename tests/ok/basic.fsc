// 基本機能のテスト / basic feature test
struct Point { x: i64, y: i64 }
struct Rect { origin: Point, w: i32, h: i32 }

static LIMIT: i64 = 5;
static ORIGIN: Point = Point { x: 0, y: 0 };
static NAME: Str = "fascon";

fn sum(p: &Point) -> i64 { p.x + p.y }

fn bump(p: &mut Point, d: i64) {
    p.x += d;
    p.y = p.y + d * 2;
}

fn classify(n: i64) -> i64 {
    let kind: i64 = if n < 0 { 0 } else { 1 };
    match n % 3 {
        0 => { kind + 10 }
        1 => kind + 20,
        _ => kind + 30,
    }
}

fn area(r: &Rect) -> i32 { r.w * r.h }

fn first_even(xs: &[i32; 6]) -> Option<i32> {
    for i in 0..6 {
        if xs[i] % 2 == 0 {
            return Some(xs[i]);
        }
    }
    None
}

fn main() {
    let mut p = Point { x: 40, y: 1 };
    bump(&mut p, 1);
    print_int(sum(&p));
    let q = p.clone();
    print_int(q.x);
    let mut i = 0;
    let mut acc: i64 = 0;
    while i < LIMIT {
        acc += classify(i);
        i += 1;
    }
    print_int(acc);
    let r = Rect { origin: ORIGIN.clone(), w: 6, h: 7 };
    print_int(area(&r));
    let xs = [1, 3, 5, 8, 9, 10];
    match first_even(&xs) {
        Some(v) => print_int(v),
        None => print_int(-1),
    }
    if let Some(v) = first_even(&xs) {
        put_str("even: ");
        put_int(v);
        print_str("");
    }
    let mut total: u64 = 0;
    for k in 0..=10 {
        if k == 3 { continue; }
        total = total + k;
    }
    print_int(total);
    print_str(NAME);
    print_int(NAME.len());
    let big: u8 = 255;
    put_hex(big);
    print_str("");
    let o: Option<i64> = None;
    print_int(o.unwrap_or(7));
}
