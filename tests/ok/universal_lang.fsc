// ユニバーサル OS 拡張の言語機能（PC で動く部分）: Result と ?、catch_fault、atomic、rcu_read、#[secret]、#[on_drop]、
// #[no_column]、dma own、bind_mmio、#[asm]、extern "C"、FaultError
// universal-OS language features that run on a PC

struct PacketMeta { len: u32, flags: u32, #[no_column] hits: u64 }
arena pkt_pool: PacketMeta[64];

const FLAG_RX: u32 = 1;
const FLAG_TX: u32 = 2;

#[secret]
#[on_drop(wipe_note)]
struct SessionKey { k: [u8; 16], epoch: u32 }

fn wipe_note(key: &mut SessionKey) {
    // 秘密の中身は出力できない（F3301）。ここでは呼ばれたことだけを出す / secrets cannot be printed (F3301)
    key.epoch = 0;
    print_str("on_drop");
}

struct Regs { ctrl: u32, status: u32, data: [u32; 4] }

#[asm(aarch64 = "mrs {r}, cntvct_el0", x86_64 = "rdtsc; shl $32, %rdx; or %rdx, %rax; mov %rax, {r}", host = "UINT64_C(7)", effects = "none", clobbers = "rdx")]
fn read_counter() -> u64;

#[asm(host = "{a} * 2 + {b}", effects = "none")]
fn twice_plus(a: u64, b: u64) -> u64;

fn parse_len(n: u32) -> Result<u32, FaultError> {
    if n > 1500 {
        return Err(EINVAL);
    }
    Ok(n)
}

fn total(a: u32, b: u32) -> Result<u32, FaultError> {
    let x = parse_len(a)?;
    let y = parse_len(b)?;
    Ok(x + y)
}

fn stale_read(id: Id<pkt_pool>) -> u32 {
    pkt_pool[id].len
}

fn main() {
    // Result と ? / Result and ?
    match total(100, 200) {
        Ok(v) => print_int(v),
        Err(e) => print_int(e.code()),
    }
    match total(100, 9000) {
        Ok(v) => print_int(v),
        Err(e) => print_int(e.code()),
    }
    let r = total(1, 2);
    if r.is_ok() {
        print_int(r.unwrap());
    }
    print_int(total(5000, 1).unwrap_or(77));

    // atomic: 1 つのスロットの整数フィールドへの RMW / one RMW on an integer field of one slot
    let a = pkt_pool.alloc(PacketMeta { len: 60, flags: 0, hits: 0 }).unwrap();
    let b = pkt_pool.alloc(PacketMeta { len: 1500, flags: 0, hits: 0 }).unwrap();
    atomic { pkt_pool[a].flags |= FLAG_RX; }
    atomic { pkt_pool[b].flags |= FLAG_TX; }
    atomic { pkt_pool[a].hits += 5; }
    print_int(pkt_pool[a].flags + pkt_pool[b].flags * 10);
    print_int(pkt_pool[a].hits);

    // #[no_column] のフィールドを読む集計は列を作らずスロットを直接走査する / a reduction over a #[no_column] field scans slots
    let mut hits: u64 = 0;
    for id in pkt_pool {
        hits += pkt_pool[id].hits;
    }
    print_int(hits);
    let mut lens: u64 = 0;
    for id in pkt_pool {
        lens += pkt_pool[id].len as u64;
    }
    print_int(lens);

    // rcu_read: 読み取り専用の区間 / a read-only section
    let mut seen: u32 = 0;
    rcu_read {
        if let Some(p) = pkt_pool.get(a) {
            seen = p.len;
        }
    }
    print_int(seen);

    // catch_fault: 古い Id のラッチを Err(ESTALE) で受ける / catch a stale-Id latch as Err(ESTALE)
    pkt_pool.free(b);
    let caught = catch_fault {
        let v = stale_read(b);
        v + 1
    };
    match caught {
        Ok(v) => print_int(v),
        Err(e) => print_int(e.code()),
    }
    let caught2 = catch_fault {
        let w = pkt_pool[b].len;
        w + 1
    };
    match caught2 {
        Ok(v) => print_int(v),
        Err(e) => print_int(e.code()),
    }
    let caught3 = catch_fault { total(2000, 1).unwrap() };
    match caught3 {
        Ok(v) => print_int(v),
        Err(e) => print_int(e.code()),
    }

    // #[secret] + #[on_drop]: 定数時間の比較と、破棄の順序（on_drop → 0 埋め → 解放）
    // constant-time comparison and the drop order (on_drop → zeroing → free)
    {
        let k1 = SessionKey { k: [7; 16], epoch: 3 };
        let k2 = SessionKey { k: [7; 16], epoch: 4 };
        if ct_eq(&k1.k, &k2.k) {
            print_str("keys equal (constant time)");
        }
    }
    #[secret] let pin: [u8; 4] = [1, 2, 3, 4];
    print_int(if ct_eq(&pin, &[1, 2, 3, 4]) { 1 } else { 0 });

    // dma own: 独立したページ、貸し出し中は CPU から触れない（F3401）、complete で取り戻す
    // dma own: dedicated pages; untouchable while lent (F3401); taken back by complete_dma
    let mut buf = dma_alloc([u8; 4096]);
    buf[0] = 0x5a;
    buf[4095] = 0xa5;
    let iova = submit_dma(buf);
    match complete_dma([u8; 4096], iova) {
        Some(back) => print_int(back[0] as u32 + back[4095] as u32),
        None => print_str("lost"),
    }
    match complete_dma([u8; 4096], iova) {
        Some(_) => print_str("double completion accepted?!"),
        None => print_str("double completion rejected"),
    }

    // bind_mmio: 登録された装置の窓（PC ではプラットフォーム層の仮の装置）/ a registered device window (a fake device on the PC)
    let regs = bind_mmio(Regs, 0x1000_0000);
    regs.ctrl = 3;
    regs.data[2] = 41;
    print_int(regs.ctrl + regs.data[2] + regs.status);
    let bad = catch_fault {
        let r2 = bind_mmio(Regs, 0xdead_0000);
        r2.status
    };
    match bad {
        Ok(v) => print_int(v),
        Err(e) => print_int(e.code()),
    }

    // #[asm]（PC では host の式） / #[asm] (the host expression on a PC)
    print_int(twice_plus(20, 2));
    print_int(if read_counter() > 0 { 1 } else { 0 });

    // FaultError
    let f = fault(28);
    print_int(f.code());
    print_int(EFAULT.code() + ESTALE.code());
    print_int(clock_mono_ns() * 0 + cpu_this() as u64);
}
