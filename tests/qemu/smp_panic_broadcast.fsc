// パニック時の全コア停止: コア 1〜3 はロックにもコンソールにも触れない計算を続ける（旗を見る場所が無い）。CPU0 がパニックすると、
// fascon_plat_panic_broadcast（AArch64: GIC の SGI 2）がほかの 3 つのコアの割り込みと実行を止め、BSP がその数を報告して
// 終了コード 70 で終わる（DMA や MMIO を壊し続けるコアを残さない）
// the all-core stop on panic: cores 1 to 3 keep computing without touching locks or the console (they never look at a
// flag). When CPU0 panics, fascon_plat_panic_broadcast (AArch64: GIC SGI 2) stops interrupts and execution on the three
// other cores; the BSP reports how many stopped and the run ends with exit code 70 (no core is left scribbling over DMA
// buffers or MMIO)
struct Acc { n: u64 }
arena acc: Acc[1];

fn spin(c: u64) {
    acc.alloc(Acc { n: 0 });
    loop {
        for id in acc {
            acc[id].n = acc[id].n.wrapping_add(c);
        }
    }
}

fn main() {
    spawn_on(1, spin, 1);
    spawn_on(2, spin, 2);
    spawn_on(3, spin, 3);
    let mut x: u64 = 0;
    for i in 0..2000000 {
        x = x.wrapping_add(i);
    }
    let none: Option<u64> = if x == 0 { Some(1) } else { None };
    print_int(none.unwrap() as i64);
    print_str("UNREACHABLE");
}
