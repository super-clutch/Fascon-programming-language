// expect: F2603
// マルチコアの critical はコアの間のロック: ロックを持ったままタスクを切り替えると、ほかのコアがロックを待って止まる
// on multi-core critical is a lock between cores: switching tasks while holding it stops every core waiting for the lock
struct Task { pid: u32 }
task_arena task: Task[4] stack 16384;
fn work(a: u64) {
    loop {
        let me = task.current();
        critical {
            task.yield_to(me);
        }
    }
}
fn core_main(c: u64) {
    let t = task.start(Task { pid: c as u32 }, work, c).unwrap();
    task.enter(t);
}
fn main() {
    spawn_on(1, core_main, 1);
    core_main(0);
}
