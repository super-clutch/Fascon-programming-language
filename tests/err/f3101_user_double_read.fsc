// expect: F3101
// ユーザー空間のバッファは 1 回だけ写す（2 回読むと TOCTOU） / a user buffer is copied exactly once (two reads = TOCTOU)
struct Task { pid: u32 }
task_arena task: Task[4] stack 16384;
user_mem umem for task: 0x20_0000 at 0x1_0000_0000;
#[syscall(4)]
fn sys_write(fd: u32, ubuf: user [u8; 64]) -> Result<usize, FaultError> {
    let a = copy_from_user(ubuf)?;
    let b = copy_from_user(ubuf)?;
    Ok((a[0] + b[0]) as usize + fd as usize)
}
fn main() {}
