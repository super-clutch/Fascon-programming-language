// expect: F2502
struct Task { pid: u32 }
task_arena task: Task[4] stack 16384;
user_mem umem for task: 0x20_0000 at 0x1_0000_0000;
fn main() {
    let t = task.start_user(Task { pid: 1 }, 0x1_0000_0000, 0x1_0020_0000).unwrap();
    if let Some(m) = umem.of(t) {
        task.free(t);                 // 窓が生きている間に、そのタスクを解放
        m[0] = 1;
    }
}
